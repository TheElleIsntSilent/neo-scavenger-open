{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Godot Run",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program":"C:/Godot/Godot_v4.7.1-stable_mono_win64.exe",
            "cwd":"${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false,
//            "args": ["--path","${workspaceRoot}"]
            "args": ["--scene","${workspaceRoot}/hello_world.tscn"],
            "logging":{
                "diagnosticsLog": {
//                    "debugEngineAPITracing": "all"
                }
            }
            
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}

